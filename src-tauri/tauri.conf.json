{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Raindrop GUI",
  "version": "0.1.0",
  "identifier": "com.babilosapiens.raindrop-gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:front && ./scripts/preparer-ressources.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Raindrop GUI",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": [
      "ressources/**/*"
    ]
  }
}
