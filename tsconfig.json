{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "outDir": "dist-sidecar",
    "rootDir": "."
  },
  "include": ["shared/**/*.ts", "sidecar/**/*.ts"],
  "exclude": ["**/*.test.ts", "sidecar/testing/**"]
}
